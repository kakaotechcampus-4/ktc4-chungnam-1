{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observedContext",
    "conversationContext",
    "uncertainties",
    "conversationOpeners"
  ],
  "properties": {
    "observedContext": {
      "type": "string",
      "minLength": 1
    },
    "conversationContext": {
      "type": "string",
      "minLength": 1
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conversationOpeners": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
