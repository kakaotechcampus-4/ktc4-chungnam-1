# app/.env 로 복사해서 채운다. app/.env 는 커밋 대상이 아니다.
# 앱을 빌드할 때 넘어가는 값이다. `flutter run --dart-define-from-file=.env`
#
# 서버가 실행 중에 읽는 backend/.env 와 다른 파일이다. 여기 적은 값은
# APK 안에 그대로 들어가므로, 세션 서명 키 같은 비밀값은 넣지 않는다.

# 구글 웹 클라이언트 ID. backend/.env 의 SAEROK_GOOGLE_CLIENT_IDS 와 같아야 한다.
SAEROK_GOOGLE_SERVER_CLIENT_ID=

# 에뮬레이터: http://10.0.2.2:8000 (기본값이라 비워도 된다)
# USB 실기기: http://127.0.0.1:8000 + adb reverse tcp:8000 tcp:8000
# 같은 공유기의 실기기: http://<PC 의 LAN 주소>:8000 + 서버를 --host 0.0.0.0 으로 실행
SAEROK_API_BASE_URL=http://127.0.0.1:8000
