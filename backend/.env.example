SAEROK_ENVIRONMENT=development
SAEROK_LOG_LEVEL=INFO
SAEROK_SERVICE_NAME=saerok-backend
SAEROK_SERVICE_VERSION=0.1.0

# 내부 AI 서버의 기본 주소와 동기 음성 분석 요청 제한 시간(초).
# 제한 시간은 STT 호출 한 번(30분 조각 하나)마다 적용되며, 음성 worker는 이 값이
# SAEROK_SPEECH_ANALYSIS_LEASE_SECONDS보다 60초 이상 짧아야 시작한다.
SAEROK_AI_SERVER_URL=http://127.0.0.1:8001
SAEROK_AI_SERVER_TIMEOUT_SECONDS=600
# 기본 GPU는 위 주소로 유지. 비워 두면 예비 서버 전환은 꺼져 있다.
SAEROK_AI_SERVER_BACKUP_URL=
# 예비 서버를 설정했을 때만 적용. 연결 전 실패에 한해 예비 서버를 한 번 시도한다.
SAEROK_AI_SERVER_FAILOVER_CONNECT_TIMEOUT_SECONDS=5

# Alembic과 앱이 사용할 로컬 PostgreSQL 연결 문자열. 실제 값은 커밋하지 않는다.
# compose의 api 컨테이너에서 db 컨테이너에 붙을 때는 호스트를 localhost 대신 db로 쓴다.
SAEROK_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/saerok

# compose.yml의 db 서비스(--profile local-db)를 쓸 때만 필요한 PostgreSQL 비밀번호.
SAEROK_POSTGRES_PASSWORD=

# 개발 서버의 HTTPS 앞단(compose --profile https)이 인증서를 받을 이름.
# Elastic IP의 점을 하이픈으로 바꾼 <IP>.sslip.io 형식이다. 실제 주소는 커밋하지 않는다.
SAEROK_PUBLIC_HOST=

# 면회 녹음 임시 저장. 기한 삭제 작업과 Lifecycle 보조 규칙은 별도 운영 설정이다.
# Lifecycle 1일 만료는 비동기 처리이므로 업로드 후 24시간 이내 삭제를 보장하지 않는다.
SAEROK_SPEECH_AUDIO_S3_BUCKET=
SAEROK_SPEECH_AUDIO_S3_REGION=ap-northeast-2
SAEROK_SPEECH_AUDIO_S3_PREFIX=temporary/speech
SAEROK_SPEECH_AUDIO_S3_ENCRYPTION=AES256
SAEROK_SPEECH_AUDIO_PRESIGNED_TTL_SECONDS=900
SAEROK_SPEECH_AUDIO_RETENTION_SECONDS=86100
SAEROK_MAX_AUDIO_BYTES=536870912
SAEROK_SPEECH_ANALYSIS_LEASE_SECONDS=900
SAEROK_SPEECH_WORKER_POLL_SECONDS=2
# Compose 종료 유예. 전사와 리포트 임대가 각각 900초이므로 2단계 + 저장 여유 60초.
# 30분 조각으로 나눈 긴 녹음은 종료 요청 때 진행 중인 조각만 마치고 대기열로 되돌린다.
SAEROK_SPEECH_STOP_GRACE_SECONDS=1860

# 프로필 사진과 면회 사진 저장. 계속 보관하므로 녹음 버킷의 임시 자료 Lifecycle이
# 적용되지 않는 비공개 버킷을 쓴다. 비어 있으면 사진 업로드와 조회 URL 생성을 거절한다.
SAEROK_IMAGE_S3_BUCKET=
SAEROK_IMAGE_S3_REGION=ap-northeast-2
SAEROK_IMAGE_S3_PREFIX=photos
SAEROK_IMAGE_S3_ENCRYPTION=AES256
SAEROK_IMAGE_PRESIGNED_TTL_SECONDS=900
SAEROK_MAX_IMAGE_BYTES=20971520

# 구글 ID 토큰의 aud 로 허용할 클라이언트 ID. 쉼표로 구분한다.
# 비어 있으면 로그인이 AUTH_NOT_CONFIGURED 로 거부된다.
SAEROK_GOOGLE_CLIENT_IDS=

# 자체 세션 토큰 서명 키. 32바이트 이상으로 직접 만들어 넣는다. 저장소에 올리지 않는다.
SAEROK_SESSION_SECRET=
SAEROK_SESSION_TTL_SECONDS=3600
SAEROK_REGISTRATION_TTL_SECONDS=600

SAEROK_CONSENT_VERSION=2026-09-06
# 이메일과 구글 계정 이름 저장 여부. ADR-007 의 PM 제안에 따라 기본은 저장하지 않음이다.
SAEROK_STORE_GOOGLE_PROFILE=false

# 받을 수 있는 가장 낮은 안드로이드 앱 versionCode. X-App-Version-Code 가 이보다 낮으면 426.
# 0 이면 검사하지 않는다. 구버전과 맞지 않는 서버를 올리기 전에, 맞는 앱을 Play 에 낸 뒤 올린다.
SAEROK_MIN_ANDROID_VERSION_CODE=0

# 카드 생성(API 4-1). ML API 키는 커밋하지 않음. 비어 있으면 카드 생성 안 함.
SAEROK_CARD_GENERATION_MODEL=gpt-6-luna
SAEROK_CARD_GENERATION_PROMPT_VERSION=3
SAEROK_ML_API_KEY=
SAEROK_CARD_GENERATION_LEASE_SECONDS=300
# 4-1 뒤 이 시간(초)이 지나도 worker가 가져가지 않았고, 이 시간 동안 worker가 어떤 작업도 가져가지 않았으면 실패로 정리한다. 임대 시간보다 길게 둔다.
SAEROK_CARD_GENERATION_START_TIMEOUT_SECONDS=360
SAEROK_CARD_WORKER_POLL_SECONDS=2
# Compose 종료 유예. 카드 임대 300초 + 저장 여유 60초.
SAEROK_CARD_STOP_GRACE_SECONDS=360
# 리포트 생성(8-3). 음성 worker가 위 ML API 키로 부름. 키가 비어 있으면 음성 worker가 시작하지 않음.
SAEROK_REPORT_GENERATION_MODEL=gpt-6-luna
# 리포트 생성 전체 제한 시간(초). SAEROK_SPEECH_ANALYSIS_LEASE_SECONDS보다 60초 이상 짧아야 함.
SAEROK_REPORT_GENERATION_TIME_LIMIT_SECONDS=600

# 리포트 완료 푸시(FCM). Firebase 서비스 계정 키는 커밋하지 않음. 둘 다 비우면 푸시 없이 동작.
# SAEROK_FCM_KEY_FILE: compose가 speech-worker에 붙일 호스트의 키 파일 경로
# SAEROK_FCM_CREDENTIALS_PATH: worker가 읽는 경로. compose면 /run/secrets/fcm-service-account.json
SAEROK_FCM_KEY_FILE=
SAEROK_FCM_CREDENTIALS_PATH=
SAEROK_FCM_TIMEOUT_SECONDS=10

# 계정별 사용 한도(2026-11-09 PM 결정). 짧은 음성 전사(6-6) 동시 요청 수, 푸시 받을 기기 수,
# 면회 회차당 리포트 재요청(6-5) 수. 넘으면 6-6은 429, 6-5는 409, 기기는 가장 오래된 등록을 지운다.
SAEROK_SHORT_TRANSCRIPTION_CONCURRENCY_PER_ACCOUNT=2
# 6-6 서버 전체 동시 처리 수. 비워 두면 제한 없음. 넘으면 503 SPEECH_TRANSCRIPTION_BUSY.
# STT 서버의 동시 처리 수를 확인하고 PM이 확인한 뒤 넣는다.
SAEROK_SHORT_TRANSCRIPTION_CONCURRENCY_TOTAL=
# 6-6이 STT 응답을 기다리는 시간(초, 잠정). 앱의 2분 제한(업로드 포함)보다 짧게 둔다.
SAEROK_SHORT_TRANSCRIPTION_TIMEOUT_SECONDS=90
SAEROK_PUSH_DEVICES_PER_ACCOUNT=5
SAEROK_REPORT_RETRIES_PER_SESSION=3
